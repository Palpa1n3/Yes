<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ck_clock"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">
    <TextClock android:id="@+id/ck_time" style="@style/WText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="40sp" android:textStyle="bold" />
</LinearLayout>
