<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

  <LinearLayout
    android:id="@+id/wx_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView android:id="@+id/wx_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="52sp" />
        <TextView android:id="@+id/wx_temp" style="@style/WText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:id="@+id/wx_line" style="@style/WText" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/wx_place" style="@style/WText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1.15"
        android:orientation="vertical">

        <LinearLayout style="@style/WxRow"><TextView android:id="@+id/wx_d0" style="@style/WxDay" /><TextView android:id="@+id/wx_i0" style="@style/WxIcon" /><TextView android:id="@+id/wx_t0" style="@style/WxTemp" /></LinearLayout>
        <ImageView style="@style/WxLine" />
        <LinearLayout style="@style/WxRow"><TextView android:id="@+id/wx_d1" style="@style/WxDay" /><TextView android:id="@+id/wx_i1" style="@style/WxIcon" /><TextView android:id="@+id/wx_t1" style="@style/WxTemp" /></LinearLayout>
        <ImageView style="@style/WxLine" />
        <LinearLayout style="@style/WxRow"><TextView android:id="@+id/wx_d2" style="@style/WxDay" /><TextView android:id="@+id/wx_i2" style="@style/WxIcon" /><TextView android:id="@+id/wx_t2" style="@style/WxTemp" /></LinearLayout>
        <ImageView style="@style/WxLine" />
        <LinearLayout style="@style/WxRow"><TextView android:id="@+id/wx_d3" style="@style/WxDay" /><TextView android:id="@+id/wx_i3" style="@style/WxIcon" /><TextView android:id="@+id/wx_t3" style="@style/WxTemp" /></LinearLayout>
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
