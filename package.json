{
  "name": "arc",
  "productName": "ARC",
  "version": "0.19.1",
  "description": "Holographic desktop AI assistant",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:phone",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/ensure-electron.cjs",
    "setup:electron": "node scripts/ensure-electron.cjs",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "installer": "npm run build && electron-builder --win nsis --publish never",
    "package:dir": "npm run build && electron-builder --dir",
    "typecheck:phone": "tsc --noEmit -p tsconfig.phone.json",
    "build:phone": "vite build --config vite.phone.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "axe-core": "4.14.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "framer-motion": "14.14.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "lucide-react": "1.74.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zustand": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@huggingface/transformers": "^4.3.2",
    "electron-updater": "6.8.12",
    "ical.js": "^2.2.1",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "qrcode-generator": "2.0.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "systeminformation": "5.33.23"
  },
  "author": "ARC"
}
