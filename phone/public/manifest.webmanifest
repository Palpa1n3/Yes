{
  "name": "Alton",
  "short_name": "Alton",
  "description": "Your Alton assistant on your phone, with or without the PC.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#050a10",
  "theme_color": "#050a10",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "New chat",
      "url": "./?new=1"
    },
    {
      "name": "Talk to Alton",
      "short_name": "Talk",
      "url": "./?talk=1"
    },
    {
      "name": "Text someone",
      "short_name": "Text",
      "url": "./?q=Text%20"
    },
    {
      "name": "Brief me",
      "short_name": "Brief me",
      "url": "./?brief=1"
    },
    {
      "name": "Add my shifts",
      "short_name": "Shifts",
      "url": "./?shifts=1"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
